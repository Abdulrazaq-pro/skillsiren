{
  "name": "skillsiren-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for SkillSiren — AI skills matching for freelancers, independent professionals and the small teams that hire them.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/generate-assets.mjs",
    "zip": "node scripts/package-zip.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=18.18"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not dead"
  ]
}
