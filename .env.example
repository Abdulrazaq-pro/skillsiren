# SkillSiren website — environment variables
# Copy to .env (never commit .env). Only variables prefixed with VITE_ are
# exposed to the browser, so never put secrets (API keys, SES credentials) here.

# Public site origin used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_URL=https://www.skillsiren.site

# Endpoint that receives early-access and contact form submissions as JSON (POST).
# Options:
#   - The included AWS Lambda function (server/contact-lambda) behind a Function URL
#     or API Gateway route, e.g. https://xxxx.lambda-url.us-east-1.on.aws/
#   - A hosted form backend that accepts JSON, e.g. https://formspree.io/f/<form-id>
# Leave empty to disable online submission: forms will validate and then offer
# a prefilled email to aina@skillsiren.site instead (no fake success state).
VITE_FORM_ENDPOINT=
